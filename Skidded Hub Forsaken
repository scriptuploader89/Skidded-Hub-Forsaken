                        if isKiller and Settings.ESPKiller then
                            ApplyKillerESP(plr)
                        elseif not isKiller and Settings.ESPPlayers then
                            ApplyPlayerESP(plr)
                        end
                    end
                else
                    RemoveESP(plr)
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    RemoveESP(plr)
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    RootPart = char:WaitForChild("HumanoidRootPart")
    Humanoid = char:WaitForChild("Humanoid")
    ClearAllESP()
    task.wait(1)
    RefreshESP()
end)

