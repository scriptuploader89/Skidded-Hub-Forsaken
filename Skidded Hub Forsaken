    box.SurfaceTransparency = 0.8
    box.SurfaceColor3 = color or Color3.fromRGB(255, 0, 0)

    billboard.Parent = part
    return billboard, box
end

local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in ipairs(ESPObjects[player]) do
            if obj and obj.Parent then
                obj:Destroy()
            end
        end
        ESPObjects[player] = nil
    end
end

local function ApplyPlayerESP(player)
    RemoveESP(player)
    local char = GetCharacterFromPlayer(player)
    if not char then return end
    local root = GetRootFromCharacter(char)
    local head = char:FindFirstChild("Head")
    if not root then return end

    local isKiller = false
    if player.Team then
        local tn = player.Team.Name:lower()
        if tn:find("killer") or tn:find("slasher") or tn:find("murderer") then
            isKiller = true
        end
    end

    local color = isKiller and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 200, 255)
    local displayName = "[" .. (isKiller and "KILLER" or "SURVIVOR") .. "] " .. player.Name

    local board, box = CreateESPLabel(root, displayName, color)
    box.Adornee = char
    box.Parent = char

    ESPObjects[player] = {board, box}
end

local function ApplyKillerESP(player)
    RemoveESP(player)
    local char = GetCharacterFromPlayer(player)
    if not char then return end
    local root = GetRootFromCharacter(char)
    if not root then return end

    local color = Color3.fromRGB(255, 0, 0)
    local displayName = "[KILLER] " .. player.Name

    local board, box = CreateESPLabel(root, displayName, color)
    box.Adornee = char
    box.Parent = char

    ESPObjects[player] = {board, box}
end

local function RefreshESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local isKiller = false
            if plr.Team then
                local tn = plr.Team.Name:lower()
                if tn:find("killer") or tn:find("slasher") or tn:find("murderer") then
                    isKiller = true
                end
            end

            if Settings.ESPPlayers and not isKiller then
                ApplyPlayerESP(plr)
            elseif Settings.ESPKiller and isKiller then
                ApplyKillerESP(plr)
            elseif not Settings.ESPPlayers and not Settings.ESPKiller then
                RemoveESP(plr)
            elseif Settings.ESPPlayers and isKiller and not Settings.ESPKiller then
                RemoveESP(plr)
            elseif not Settings.ESPPlayers and not isKiller then
                RemoveESP(plr)
            end
        end
    end
end

local function ClearAllESP()
    for plr, _ in pairs(ESPObjects) do
        RemoveESP(plr)
    end
end

