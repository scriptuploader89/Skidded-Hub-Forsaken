local function startAutoFix()
    if Variables.GeneratorConnection then
        Variables.GeneratorConnection:Disconnect()
    end
    Variables.GeneratorConnection = RunService.Heartbeat:Connect(function()
        if not Variables.AutoFixEnabled then
            return
        end
        local gens = findNearbyGenerators()
        local myHRP = getHRP(LocalPlayer)
        if not myHRP then return end
        for _, gen in ipairs(gens) do
            local genPart = gen
            if gen:IsA("Model") then
                for _, part in ipairs(gen:GetDescendants()) do
                    if part:IsA("BasePart") then
                        genPart = part
                        break
                    end
                end
            end
            if genPart and genPart:IsA("BasePart") then
                local dist = (myHRP.Position - genPart.Position).Magnitude
                if dist <= 15 then
                    if gen:IsA("Model") then
                        for _, desc in ipairs(gen:GetDescendants()) do
                            if desc:FindFirstChildOfClass("ProximityPrompt") then
                                fireProximityPrompt(desc)
                                break
                            end
                        end
                    else
                        fireProximityPrompt(gen)
                    end
                    break
                end
            end
        end
    end)
end

local function stopAutoFix()
    if Variables.GeneratorConnection then
        Variables.GeneratorConnection:Disconnect()
        Variables.GeneratorConnection = nil
    end
end

local function startInfiniteStamina()
    if Variables.StaminaConnection then
        Variables.StaminaConnection:Disconnect()
    end
    Variables.StaminaConnection = RunService.RenderStepped:Connect(function()
        if not Variables.InfiniteStamina then
            return
        end
        local char = getCharacter(LocalPlayer)
        if char then
            for _, child in ipairs(char:GetDescendants()) do
                local name = child.Name:lower()
                if child:IsA("NumberValue") or child:IsA("IntValue") then
                    if name:find("stamina") or name:find("energy") or name:find("sprint") or name:find("endurance") or name:find("fatigue") then
                        child.Value = child:IsA("IntValue") and 99999 or 100
                    end
                end
                if child:IsA("DoubleConstrainedValue") then
                    if name:find("stamina") or name:find("energy") or name:find("sprint") or name:find("endurance") then
                        child.Value = child.MaxValue
                    end
                end
            end
            local humanoid = getHumanoid(LocalPlayer)
            if humanoid then
                local staminaAttr = humanoid:GetAttribute("Stamina")
                if staminaAttr ~= nil then
                    humanoid:SetAttribute("Stamina", 100)
                end
                local energyAttr = humanoid:GetAttribute("Energy")
                if energyAttr ~= nil then
                    humanoid:SetAttribute("Energy", 100)
                end
            end
        end
    end)
end

local function stopInfiniteStamina()
    if Variables.StaminaConnection then
        Variables.StaminaConnection:Disconnect()
        Variables.StaminaConnection = nil
    end
end

