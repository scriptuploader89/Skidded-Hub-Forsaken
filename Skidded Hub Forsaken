local function GetCharacterFromPlayer(plr)
    return plr and plr.Character
end

local function GetRootFromCharacter(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoidFromCharacter(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsKillerTeam()
    local team = LocalPlayer.Team
    if team then
        local teamName = team.Name:lower()
        if teamName:find("killer") or teamName:find("slasher") or teamName:find("murderer") then
            return true
        end
    end
    return false
end

local function IsSurvivorTeam()
    return not IsKillerTeam()
end

local function GetNearestPlayer(maxDistance, excludeTeam)
    local nearest = nil
    local nearestDist = maxDistance or math.huge
    local myRoot = RootPart

    if not myRoot then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = GetCharacterFromPlayer(plr)
            local root = GetRootFromCharacter(char)
            local hum = GetHumanoidFromCharacter(char)
            if root and hum and hum.Health > 0 then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist < nearestDist then
                    if excludeTeam then
                        if plr.Team ~= LocalPlayer.Team then
                            nearestDist = dist
                            nearest = plr
                        end
                    else
                        nearestDist = dist
                        nearest = plr
                    end
                end
            end
        end
    end
    return nearest, nearestDist
end

local function GetKillerPlayer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local team = plr.Team
            if team then
                local teamName = team.Name:lower()
                if teamName:find("killer") or teamName:find("slasher") or teamName:find("murderer") then
                    local char = GetCharacterFromPlayer(plr)
                    local root = GetRootFromCharacter(char)
                    local hum = GetHumanoidFromCharacter(char)
                    if root and hum and hum.Health > 0 then
                        return plr
                    end
                end
            end
        end
    end
    return nil
end

local function LookAtTarget(targetRoot)
    if not RootPart or not targetRoot then return end
    local direction = (targetRoot.Position - RootPart.Position)
    direction = Vector3.new(direction.X, 0, direction.Z).Unit
    local lookCFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + direction)
    RootPart.CFrame = lookCFrame
end

local function CreateESPLabel(part, name, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Label"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = part

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = name
    label.TextColor3 = color or Color3.fromRGB(255, 0, 0)
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

