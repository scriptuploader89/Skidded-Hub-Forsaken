local function findNearbyGenerators()
    local generators = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Parent:FindFirstChildOfClass("Humanoid") then
            local name = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            if name:find("generator") or name:find("gen") or parentName:find("generator") or parentName:find("gen") then
                if obj:FindFirstChildOfClass("ProximityPrompt") or obj.Parent:FindFirstChildOfClass("ProximityPrompt") then
                    table.insert(generators, obj)
                end
            end
        end
    end
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") then
            local name = model.Name:lower()
            if name:find("generator") or name:find("gen") then
                for _, part in ipairs(model:GetDescendants()) do
                    if part:IsA("BasePart") and part:FindFirstChildOfClass("ProximityPrompt") then
                        table.insert(generators, model)
                        break
                    end
                end
            end
        end
    end
    return generators
end

local function fireProximityPrompt(obj)
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
    if not prompt and obj.Parent then
        prompt = obj.Parent:FindFirstChildOfClass("ProximityPrompt")
    end
    if not prompt and obj.Parent and obj.Parent.Parent then
        prompt = obj.Parent.Parent:FindFirstChildOfClass("ProximityPrompt")
    end
    if prompt then
        if prompt.RequiresLineOfSight then
            prompt.RequiresLineOfSight = false
        end
        prompt.HoldDuration = Variables.FixTime
        fireproximityprompt(prompt)
    end
end

local function findNearestKiller()
    local nearest = nil
    local nearestDist = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and getCharacter(plr) then
            local char = getCharacter(plr)
            local isKiller = false
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:lower():find("kill") or tool.Name:lower():find("weapon") or tool.Name:lower():find("sword") or tool.Name:lower():find("axe") or tool.Name:lower():find("knife") or tool.Name:lower():find("slasher")) then
                    isKiller = true
                    break
                end
            end
            local backpack = plr:FindFirstChild("Backpack")
            if not isKiller and backpack then
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and (tool.Name:lower():find("kill") or tool.Name:lower():find("weapon") or tool.Name:lower():find("sword") or tool.Name:lower():find("axe") or tool.Name:lower():find("knife") or tool.Name:lower():find("slasher")) then
                        isKiller = true
                        break
                    end
                end
            end
            if not isKiller then
                if plr.TeamColor == BrickColor.new("Really red") or plr.TeamColor == BrickColor.new("Bright red") then
                    isKiller = true
                end
            end
            if isKiller then
                local myHRP = getHRP(LocalPlayer)
                local theirHRP = getHRP(plr)
                if myHRP and theirHRP then
                    local dist = (myHRP.Position - theirHRP.Position).Magnitude
                    if dist < nearestDist and dist <= Variables.AimbotRange then
                        nearestDist = dist
                        nearest = plr
                    end
                end
            end
        end
    end
    return nearest
end

