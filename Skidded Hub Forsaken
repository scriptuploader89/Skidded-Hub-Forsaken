local function startPlayerAimbot()
    if Variables.PlayerAimbotConnection then
        Variables.PlayerAimbotConnection:Disconnect()
    end
    createNotificationGUI("Player aimbot")
    Variables.PlayerAimbotConnection = RunService.RenderStepped:Connect(function()
        if not Variables.PlayerAimbot then
            Variables.PlayerAimbotConnection:Disconnect()
            Variables.PlayerAimbotConnection = nil
            removeNotificationGUI("Player aimbot")
            return
        end
        local target = findNearestPlayer()
        if target then
            local myHRP = getHRP(LocalPlayer)
            local theirHRP = getHRP(target)
            if myHRP and theirHRP then
                local humanoid = getHumanoid(LocalPlayer)
                if humanoid then
                    humanoid.AutoRotate = false
                end
                local direction = (theirHRP.Position - myHRP.Position).Unit
                direction = Vector3.new(direction.X, 0, direction.Z)
                if direction.Magnitude > 0 then
                    local lookAt = CFrame.new(myHRP.Position, myHRP.Position + direction)
                    local gyro = myHRP:FindFirstChildOfClass("BodyGyro")
                    if not gyro then
                        gyro = Instance.new("BodyGyro")
                        gyro.MaxTorque = Vector3.new(400000, 400000, 400000)
                        gyro.P = 30000
                        gyro.D = 1000
                        gyro.Name = "SkiddedHub_AimbotGyro"
                        gyro.Parent = myHRP
                    end
                    gyro.CFrame = lookAt
                end
            end
        else
            local myHRP = getHRP(LocalPlayer)
            if myHRP then
                local gyro = myHRP:FindFirstChild("SkiddedHub_AimbotGyro")
                if gyro then
                    gyro:Destroy()
                end
                local humanoid = getHumanoid(LocalPlayer)
                if humanoid then
                    humanoid.AutoRotate = true
                end
            end
        end
    end)
end

local function stopPlayerAimbot()
    if Variables.PlayerAimbotConnection then
