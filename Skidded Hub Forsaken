local function createHighlight(plr, color)
    local char = getCharacter(plr)
    if not char then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = plr.Name .. "_ESP"
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Parent = ESPFolder
    highlight.Adornee = char
    table.insert(Variables.ESPObjects, highlight)
    return highlight
end

local function removeESP(plr)
    for i, obj in ipairs(Variables.ESPObjects) do
        if obj.Name == plr.Name .. "_ESP" then
            obj:Destroy()
            table.remove(Variables.ESPObjects, i)
            break
        end
    end
end

local function clearAllESP()
    for _, obj in ipairs(Variables.ESPObjects) do
        obj:Destroy()
    end
    Variables.ESPObjects = {}
end

local function updateESP()
    clearAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and getCharacter(plr) then
            if Variables.KillerESP then
                local killerTool = false
                local char = getCharacter(plr)
                if char then
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("kill") or tool.Name:lower():find("weapon") or tool.Name:lower():find("sword") or tool.Name:lower():find("axe") or tool.Name:lower():find("knife") or tool.Name:lower():find("slasher")) then
                            killerTool = true
                            break
                        end
                    end
                end
                local backpack = plr:FindFirstChild("Backpack")
                if backpack then
                    for _, tool in ipairs(backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("kill") or tool.Name:lower():find("weapon") or tool.Name:lower():find("sword") or tool.Name:lower():find("axe") or tool.Name:lower():find("knife") or tool.Name:lower():find("slasher")) then
                            killerTool = true
                            break
                        end
                    end
                end
                if killerTool or plr.TeamColor == BrickColor.new("Really red") or plr.TeamColor == BrickColor.new("Bright red") then
                    createHighlight(plr, Color3.fromRGB(255, 0, 0))
                end
            end
            if Variables.PlayerESP then
                local killerTool = false
                local char = getCharacter(plr)
                if char then
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("kill") or tool.Name:lower():find("weapon") or tool.Name:lower():find("sword") or tool.Name:lower():find("axe") or tool.Name:lower():find("knife") or tool.Name:lower():find("slasher")) then
                            killerTool = true
                            break
                        end
                    end
                end
                local backpack = plr:FindFirstChild("Backpack")
                if backpack then
                    for _, tool in ipairs(backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("kill") or tool.Name:lower():find("weapon") or tool.Name:lower():find("sword") or tool.Name:lower():find("axe") or tool.Name:lower():find("knife") or tool.Name:lower():find("slasher")) then
                            killerTool = true
                            break
                        end
                    end
                end
                if not killerTool and plr.TeamColor ~= BrickColor.new("Really red") and plr.TeamColor ~= BrickColor.new("Bright red") then
                    createHighlight(plr, Color3.fromRGB(0, 255, 0))
